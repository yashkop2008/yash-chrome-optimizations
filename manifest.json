{
  "manifest_version": 3,
  "name": "Yash's Chrome Optimizations",
  "short_name": "Yash's Chrome",
  "version": "2.4.0",
  "description": "One personal extension for everything from redesigns to small quality-of-life fixes. Every change is a feature you can switch off.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Yash's Chrome"
  },
  "options_page": "settings/settings.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "declarativeNetRequest",
    "history",
    "topSites",
    "privacy"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "features/youtube-gate/*",
        "core/tokens.css",
        "icons/48.png"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ]
    }
  ]
}
