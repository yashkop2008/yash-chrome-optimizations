{
  "manifest_version": 3,
  "name": "Yash's Chrome Optimizations",
  "short_name": "Yash's Chrome",
  "version": "3.3.0",
  "description": "One personal extension for everything from redesigns to small quality-of-life fixes. Every change is a feature you can switch off.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Yash's Chrome"
  },
  "options_page": "yash.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "history",
    "management",
    "privacy",
    "scripting",
    "storage",
    "tabs",
    "topSites"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "focus.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "omnibox": {
    "keyword": "yash"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
